{
  "name": "collision-detection-web",
  "version": "1.0.0",
  "description": "Web-based video analysis and IoT hardware control interface",
  "main": "src/index.js",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "dev": "http-server . -p 8080 -c-1 -o",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "build": "mkdir -p dist && cp -r src/* dist/ && cp index.html dist/",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "keywords": [
    "collision-detection",
    "video-analysis",
    "iot",
    "hardware-control"
  ],
  "author": "Collision Detection Team",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.56.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test-setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/test-setup.js"
    ]
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "socket.io-client": "^4.8.3"
  }
}
