# Collision Detection Server Configuration

# Server settings
HOST=0.0.0.0
PORT=5000
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# File upload settings
UPLOAD_FOLDER=/tmp/collision_uploads
MAX_CONTENT_LENGTH=524288000  # 500MB in bytes

# Camera settings
DEFAULT_CAMERA_ID=0
CAMERA_RESOLUTION_WIDTH=640
CAMERA_RESOLUTION_HEIGHT=480
CAMERA_FPS=30

# Computer vision settings
DETECTION_CONFIDENCE_THRESHOLD=0.5
TRACKING_MAX_DISAPPEARED=30
COLLISION_DISTANCE_THRESHOLD=50

# Hardware settings
ESP8266_DISCOVERY_PORT=8266
HARDWARE_COMMAND_TIMEOUT=5
DEVICE_STATUS_POLL_INTERVAL=10

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=/var/log/collision_server.log

# Performance settings
MAX_CONCURRENT_PROCESSING=2
FRAME_PROCESSING_TIMEOUT=1.0
VIDEO_PROCESSING_CHUNK_SIZE=100